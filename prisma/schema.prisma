datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         String   @default("CUSTOMER") // CUSTOMER | SELLER | ADMIN
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile Seller?
  orders        Order[]
  addresses     Address[]
  favorites     Favorite[]
  reviews       Review[]
  redemptions   CouponRedemption[]
}

model Seller {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName      String
  slug           String   @unique
  description    String
  logo           String
  banner         String?
  rating         Float    @default(5.0)
  verified       Boolean  @default(false)
  followers      Int      @default(0)
  responseRate   String   @default("%99")
  shippingPolicy String?
  returnPolicy   String?
  status         String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products    Product[]
  orderGroups OrderGroup[]
}

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  nameTR        String
  nameEN        String
  descriptionTR String
  descriptionEN String
  imageUrl      String
  parentId      String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]
}

model Product {
  id            String   @id @default(uuid())
  sellerId      String
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  name          String
  slug          String   @unique
  description   String
  brand         String
  sku           String   @unique
  price         Float
  originalPrice Float?
  stock         Int      @default(0)
  rating        Float    @default(5.0)
  reviewCount   Int      @default(0)
  imageUrl      String
  colors        String   @default("[]") // JSON string of available colors
  sizes         String   @default("[]") // JSON string of available sizes
  images        String   @default("[]") // JSON string of image URLs
  status        String   @default("ACTIVE") // DRAFT | PENDING_REVIEW | ACTIVE | REJECTED | INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
  favorites  Favorite[]
  reviews    Review[]
}

model Order {
  id                      String   @id @default(uuid())
  orderNumber             String   @unique
  customerId              String
  customer                User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status                  String   @default("CONFIRMED") // CONFIRMED | PROCESSING | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  subtotal                Float
  productDiscount         Float    @default(0)
  couponDiscount          Float    @default(0)
  shippingFee             Float    @default(0)
  grandTotal              Float
  currency                String   @default("TRY")
  paymentStatus           String   @default("paid")
  paymentMethod           String   @default("credit_card")
  trackingNumber          String?
  estimatedDelivery       String?
  shippingAddressSnapshot String // JSON string of address
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  orderItems    OrderItem[]
  orderGroups   OrderGroup[]
  statusHistory OrderStatusHistory[]
  redemptions   CouponRedemption[]
}

model OrderGroup {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status    String   @default("CONFIRMED")
  subtotal  Float
  createdAt DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id            String      @id @default(uuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderGroupId  String?
  orderGroup    OrderGroup? @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  price         Float
  selectedColor String?
  selectedSize  String?
  createdAt     DateTime    @default(now())
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  firstName   String
  lastName    String
  phone       String
  email       String?
  city        String
  district    String
  addressLine String
  country     String   @default("Türkiye")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  type            String    @default("PERCENTAGE") // PERCENTAGE | FIXED | FREE_SHIPPING
  value           Float
  minimumOrder    Float?
  maximumDiscount Float?
  expiresAt       DateTime?
  active          Boolean   @default(true)
  usageLimit      Int?
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  rating      Int
  comment     String
  status      String   @default("PUBLISHED") // PUBLISHED | HIDDEN | PENDING
  sellerReply String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSettings {
  id                          String   @id @default("default")
  marketplaceName             String   @default("Cadde Store Türkiye")
  supportEmail                String   @default("destek@cadde.store")
  defaultCommissionRate       Float    @default(10.0)
  orderCancellationWindowDays Int      @default(2)
  returnWindowDays            Int      @default(14)
  defaultShippingFee          Float    @default(34.9)
  freeShippingThreshold       Float    @default(200.0)
  updatedAt                   DateTime @updatedAt
}
