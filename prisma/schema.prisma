datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         String   @default("CUSTOMER") // CUSTOMER | SELLER | ADMIN
  adminRole    String?  // SUPER_ADMIN | CONTENT_MANAGER | MERCHANDISING_MANAGER | MARKETING_MANAGER | OPERATIONS_MANAGER
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile  Seller?
  orders         Order[]
  addresses      Address[]
  favorites      Favorite[]
  reviews        Review[]
  redemptions    CouponRedemption[]
  returnRequests ReturnRequest[]
  notifications  Notification[]
}

model Seller {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName      String
  slug           String   @unique
  description    String
  logo           String
  banner         String?
  rating         Float    @default(5.0)
  verified       Boolean  @default(false)
  followers      Int      @default(0)
  responseRate   String   @default("%99")
  commissionRate Float    @default(0.10)
  shippingPolicy String?
  returnPolicy   String?
  status         String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | REJECTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products       Product[]
  orderGroups    OrderGroup[]
  returnRequests ReturnRequest[]
}

model Category {
  id            String   @id @default(uuid())
  slug          String   @unique
  nameTR        String
  nameEN        String
  descriptionTR String
  descriptionEN String
  imageUrl      String
  parentId      String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]
}

model Brand {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  logoUrl       String
  bannerUrl     String?
  descriptionTR String?
  descriptionEN String?
  isFeatured    Boolean   @default(false)
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
}

model Product {
  id            String   @id @default(uuid())
  sellerId      String
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  brandId       String?
  brandRef      Brand?   @relation(fields: [brandId], references: [id])
  name          String
  slug          String   @unique
  description   String
  brand         String
  sku           String   @unique
  price         Float
  originalPrice Float?
  stock         Int      @default(0)
  rating        Float    @default(5.0)
  reviewCount   Int      @default(0)
  imageUrl      String
  colors        String   @default("[]") // JSON string of available colors
  sizes         String   @default("[]") // JSON string of available sizes
  images        String   @default("[]") // JSON string of image URLs
  badges        String?  // JSON string of badges e.g. ["BESTSELLER", "FAST_DELIVERY"]
  status        String   @default("ACTIVE") // DRAFT | PENDING_REVIEW | ACTIVE | REJECTED | INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
  favorites  Favorite[]
  reviews    Review[]
}

model Order {
  id                      String   @id @default(uuid())
  orderNumber             String   @unique
  customerId              String
  customer                User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status                  String   @default("CONFIRMED") // CONFIRMED | PROCESSING | SHIPPED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  subtotal                Float
  productDiscount         Float    @default(0)
  couponDiscount          Float    @default(0)
  shippingFee             Float    @default(0)
  grandTotal              Float
  currency                String   @default("TRY")
  paymentStatus           String   @default("paid")
  paymentMethod           String   @default("credit_card")
  trackingNumber          String?
  carrierName             String?  @default("Yurtiçi Kargo")
  estimatedDelivery       String?
  shippingAddressSnapshot String // JSON string of address
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  orderItems     OrderItem[]
  orderGroups    OrderGroup[]
  statusHistory  OrderStatusHistory[]
  redemptions    CouponRedemption[]
  returnRequests ReturnRequest[]
}

model OrderGroup {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status          String   @default("CONFIRMED")
  subtotal        Float
  carrierName     String?  @default("Yurtiçi Kargo")
  trackingNumber  String?
  createdAt       DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderGroupId   String?
  orderGroup     OrderGroup?     @relation(fields: [orderGroupId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  quantity       Int
  price          Float
  selectedColor  String?
  selectedSize   String?
  createdAt      DateTime        @default(now())

  returnRequests ReturnRequest[]
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  firstName   String
  lastName    String
  phone       String
  email       String?
  city        String
  district    String
  addressLine String
  country     String   @default("Türkiye")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  type            String    @default("PERCENTAGE") // PERCENTAGE | FIXED | FREE_SHIPPING
  value           Float
  minimumOrder    Float?
  maximumDiscount Float?
  expiresAt       DateTime?
  active          Boolean   @default(true)
  usageLimit      Int?
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  rating      Int
  comment     String
  status      String   @default("PUBLISHED") // PUBLISHED | HIDDEN | PENDING
  sellerReply String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSettings {
  id                          String   @id @default("default")
  marketplaceName             String   @default("Cadde Store Türkiye")
  supportEmail                String   @default("destek@cadde.store")
  defaultCommissionRate       Float    @default(10.0)
  orderCancellationWindowDays Int      @default(2)
  returnWindowDays            Int      @default(14)
  defaultShippingFee          Float    @default(34.9)
  freeShippingThreshold       Float    @default(200.0)
  updatedAt                   DateTime @updatedAt
}

model HomepageSection {
  id          String    @id @default(uuid())
  titleTR     String
  titleEN     String
  type        String    @default("HERO") // HERO | BANNER_STRIP | FLASH_DEALS | PRODUCT_CAROUSEL | CATEGORY_GRID | BRAND_STRIP | STORE_HIGHLIGHTS
  orderIndex  Int       @default(0)
  active      Boolean   @default(true)
  configJson  String    @default("{}")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  banners     Banner[]
}

model Banner {
  id              String           @id @default(uuid())
  sectionId       String?
  section         HomepageSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  titleTR         String?
  titleEN         String?
  subtitleTR      String?
  subtitleEN      String?
  imageUrlDesktop String
  imageUrlMobile  String?
  targetType      String           @default("CATEGORY") // CATEGORY | PRODUCT | BRAND | SELLER | URL
  targetValue     String           @default("/")
  badgeTextTR     String?
  badgeTextEN     String?
  orderIndex      Int              @default(0)
  active          Boolean          @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model HomepageDraft {
  id         String   @id @default("current_draft")
  draftJson  String   @default("[]") // JSON string of SectionItem[]
  updatedBy  String?
  updatedAt  DateTime @updatedAt
}

model HomepageVersion {
  id            String   @id @default(uuid())
  versionNumber Int
  snapshotJson  String   @default("[]") // JSON snapshot of published SectionItem[]
  changeSummary String?
  authorEmail   String?
  publishedAt   DateTime @default(now())
}

model HomepageTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String   @default("PRODUCT_CAROUSEL")
  configJson  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReturnRequest {
  id             String      @id @default(uuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId    String
  orderItem      OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reason         String
  status         String      @default("PENDING") // PENDING | APPROVED | REJECTED | CARGO_RECEIVED | REFUNDED
  refundAmount   Float
  evidenceImages String      @default("[]") // JSON string of URLs
  sellerNote     String?
  adminNote      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleTR   String
  titleEN   String
  messageTR String
  messageEN String
  type      String   @default("ORDER") // ORDER | PROMOTION | SYSTEM | SELLER
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actorEmail   String?
  actorRole    String?
  action       String   // e.g. SELLER_APPROVED, PRODUCT_STATUS_CHANGED, SETTINGS_UPDATED
  entityType   String   // SELLER | PRODUCT | ORDER | CATEGORY | COUPON | SETTINGS | BRAND | CMS | MARKETING | NAVIGATION | MEDIA
  entityId     String?
  metadataJson String   @default("{}")
  ipAddress    String?
  createdAt    DateTime @default(now())
}

model Campaign {
  id          String    @id @default(uuid())
  name        String
  type        String    @default("SPONSORED_PRODUCT") // SPONSORED_PRODUCT | SPONSORED_BRAND | SPONSORED_SELLER | FEATURED_SEARCH
  targetId    String?
  placement   String?
  budget      Float
  spent       Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  priority    Int       @default(1)
  status      String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  impressions Int       @default(0)
  clicks      Int       @default(0)
  orders      Int       @default(0)
  revenue     Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model NavigationItem {
  id               String           @id @default(uuid())
  titleTr          String
  titleEn          String
  url              String
  section          String           @default("HEADER") // HEADER | FOOTER | MEGA_MENU | MOBILE_DRAWER
  parentId         String?
  parent           NavigationItem?  @relation("NavHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         NavigationItem[] @relation("NavHierarchy")
  sortOrder        Int              @default(0)
  badgeTr          String?
  badgeEn          String?
  isActive         Boolean          @default(true)
  deviceVisibility String           @default("ALL") // ALL | DESKTOP | MOBILE
  itemType         String           @default("LINK") // LINK | CATEGORY | BRAND | PROMO_CARD | HEADING
  imageUrl         String?
  descriptionTr    String?
  descriptionEn    String?
  ctaTextTr        String?
  ctaTextEn        String?
  targetUrl        String?
  scheduleStartAt  DateTime?
  scheduleEndAt    DateTime?
  metadataJson     String?          @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model MediaAsset {
  id             String   @id @default(uuid())
  filename       String
  url            String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  altTextTr      String?
  altTextEn      String?
  tags           String?  // JSON string of tags
  referenceCount Int      @default(0)
  uploadedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CmsPage {
  id                  String           @id @default(uuid())
  slug                String           @unique
  titleTr             String
  titleEn             String
  type                String           @default("CUSTOM") // LANDING | STATIC | POLICY | CAMPAIGN | CUSTOM
  status              String           @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED | ARCHIVED
  sectionsJson        String           @default("[]") // JSON string of SectionItem[]
  metaTitleTr         String?
  metaTitleEn         String?
  metaDescriptionTr   String?
  metaDescriptionEn   String?
  schedulePublishAt   DateTime?
  scheduleUnpublishAt DateTime?
  publishedVersionId  String?
  authorId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  versions            CmsPageVersion[]
}

model CmsPageVersion {
  id            String   @id @default(uuid())
  pageId        String
  page          CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshotJson  String   @default("{}") // Full JSON snapshot of the page at versioning time
  publishedBy   String?
  changeSummary String?
  createdAt     DateTime @default(now())
}

model AppearanceSettings {
  id               String   @id @default("default")
  logoUrl          String?
  faviconUrl       String?
  marketplaceName  String   @default("Cadde Store")
  tagline          String?
  brandColor       String   @default("#2563eb")
  accentColor      String   @default("#f97316")
  borderRadius     String   @default("8px")
  fontHeading      String   @default("Inter")
  fontBody         String   @default("Inter")
  headerConfigJson String   @default("{}")
  footerConfigJson String   @default("{}")
  updatedAt        DateTime @updatedAt
}

model PageLayoutConfig {
  id         String   @id @default(uuid())
  pageType   String   @unique // PRODUCT | CATEGORY
  isCustom   Boolean  @default(false)
  blocksJson String   @default("[]") // JSON array of layout blocks
  updatedAt  DateTime @updatedAt
}

model RolePermission {
  id        String   @id @default(uuid())
  role      String   // SUPER_ADMIN | CONTENT_MANAGER | MERCHANDISING_MANAGER | MARKETING_MANAGER | OPERATIONS_MANAGER
  resource  String   // PAGES | HOMEPAGE | MEDIA | NAVIGATION | CATALOG | MARKETING | ORDERS | SETTINGS | AUDIT | ANALYTICS | HEALTH
  action    String   // READ | WRITE | DELETE | PUBLISH | ALL
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource, action])
}

model SectionAnalytics {
  id              String   @id @default(uuid())
  pageType        String   @default("HOMEPAGE") // HOMEPAGE | PAGE | PRODUCT | CATEGORY
  pageIdentifier  String?  // Slug or ID or "homepage"
  sectionId       String   // Section or Block ID
  sectionType     String   // HERO | PRODUCT_CAROUSEL | FLASH_DEALS | etc.
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  addToCartCount  Int      @default(0)
  revenue         Float    @default(0)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Sponsor {
  id        String    @id @default(uuid())
  name      String
  logoUrl   String
  linkUrl   String?
  startDate DateTime?
  endDate   DateTime?
  priority  Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}



